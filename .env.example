# Resumiq / ResumeIQ — environment variables (placeholders only)
# Copy to Vercel → Project → Settings → Environment Variables (Production)
# Never commit real keys.

# --- AI (at least one required for Dexa) ---
XAI_API_KEY=your_xai_grok_key_here
# or
GROQ_API_KEY=your_groq_key_here
AI_MODEL=grok-3-mini
AI_DAILY_GUEST=10
AI_DAILY_USER=40

# --- Supabase (recommended for auth + cloud sync + accurate limits) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Optional live global job search (Adzuna official API) ---
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# --- Job alert e-mails (cron runs daily at 8:10 AM IST, see vercel.json) ---
CRON_SECRET=any_long_random_text
RESEND_API_KEY=your_resend_api_key
ALERT_FROM=Resumiq <alerts@your-verified-domain.com>
# SITE_URL=https://resumiq-pekm.vercel.app

# --- Future / not activated in this release ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
